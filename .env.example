# Kee — Environment Configuration
# Copy to .env and fill in your values. NOTHING in this file should be
# personally identifying — all real values go in .env (gitignored).

# ─────────────────────────────────────────────────────────────────
# Ollama (local LLM, free)
# ─────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# Primary model for the agent brain.
#
# kee-uncensored:latest is the HauhauCS HF weights re-wrapped with the
# Qwen3 chat template (Apache 2.0) so Ollama's tool parser can read the
# responses. The raw HF release ships with an empty template that breaks
# every tool-using turn. Build the local variant once:
#
#   ollama pull hf.co/HauhauCS/Qwen3.5-9B-Uncensored-HauhauCS-Aggressive:Q4_K_M
#   ollama create kee-uncensored:latest -f scripts/kee_uncensored.Modelfile
#
KEE_MODEL=kee-uncensored:latest

# Generation parameters
KEE_TEMPERATURE=0.7
# 12288 leaves enough headroom for the system prompt + compact tool
# schema + a real reply. KV cache at q4_0 ≈ 1.5 GB; with the 9B Q4_K_M
# weights (~6.25 GB) the total fits the 8 GB RTX 5050 with margin.
KEE_NUM_CTX=12288

# Disk-aware Ollama config (Windows): point Ollama models at D:\ (or any
# non-system disk). Set this in your shell *before* starting Ollama, not
# via .env (Ollama reads this at process start).
#   PowerShell: [Environment]::SetEnvironmentVariable("OLLAMA_MODELS", "D:\Ollama\models", "User")

# ─────────────────────────────────────────────────────────────────
# LLM chain primary + cost cap
# ─────────────────────────────────────────────────────────────────
# Reorder which provider is tried first. Chain ALWAYS includes all 4 providers
# regardless; this only changes the order. Options: ollama | openai | haiku | claude
KEE_LLM_PRIMARY=ollama

# Daily LLM spend cap in USD. When reached, the chain forces ollama until
# midnight local. Defaults to 2.0.
KEE_DAILY_COST_CAP_USD=2

# KeeCode / OpenCode bridge (clean-room coding agent)
KEE_CODE_AGENT=keecode
KEE_CODE_AGENT_MODEL=kee-uncensored:latest
KEE_OPENCODE_COMMAND=opencode
# Optional: set if the auto-detected Desktop clone path is wrong.
# KEE_OPENCODE_REPO=C:/Users/you/Desktop/opencode
KEE_CODE_AGENT_DATA_DIR=./data/keecode

# ─────────────────────────────────────────────────────────────────
# Worker node (optional — for distributed inference / RAG)
# Set the hostname / Tailscale name of your secondary machine
# ─────────────────────────────────────────────────────────────────
# WORKER_HOST=worker
# WORKER_OLLAMA=http://worker:11434
# CHROMADB_HOST=http://worker:8000
# KEE_REQUIRE_WORKER=false

# ─────────────────────────────────────────────────────────────────
# Paths (relative to project root or absolute)
# ─────────────────────────────────────────────────────────────────
KEE_DATA_DIR=./data
KEE_VAULT_DIR=./vault
KEE_MODELS_DIR=./models

# ─────────────────────────────────────────────────────────────────
# Optional integrations (uncomment + set in your local .env)
# ─────────────────────────────────────────────────────────────────

# Anthropic (only if you want Claude as a chain provider — claude_code
# tool uses subprocess `claude -p` instead and needs no API key)
# ANTHROPIC_API_KEY=

# OpenAI (only if you want GPT-4o-mini as a chain provider)
# OPENAI_API_KEY=

# Telegram bot surface
# Get a token: open https://t.me/BotFather, send /newbot, follow prompts.
# Allowed users: comma-separated Telegram numeric user_ids.
#   WITHOUT this set, the bot refuses every message — safe default.
# KEE_TELEGRAM_TOKEN=
# KEE_TELEGRAM_ALLOWED_USERS=

# Resend (outbound email — risk-3 tool).
# Get the key: https://resend.com/api-keys
# Then verify a sending domain or use 'onboarding@resend.dev' for sandbox.
# RESEND_API_KEY=
# RESEND_FROM=

# Google OAuth (Calendar + Gmail integrations).
# Either drop a desktop OAuth client JSON at data/google_client.json
# (Cloud Console → Credentials → Create OAuth → "Desktop app"), OR point
# KEE_GOOGLE_CLIENT_SECRET at an existing client_secret JSON.
# Then run once: python -m kee.main google-auth (browser opens).
# KEE_GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (outbound)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ElevenLabs TTS (alternative to local Piper)
# KEE_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ─────────────────────────────────────────────────────────────────
# Notification routing
# ─────────────────────────────────────────────────────────────────
# Quiet hours window in 24h format. Defaults to "0-7" (midnight to 7 AM).
# Use "22-8" for "22:00 to 08:00" (wraps midnight).
# KEE_QUIET_HOURS=0-7

# ─────────────────────────────────────────────────────────────────
# Sleep Cycle phase opt-outs
# ─────────────────────────────────────────────────────────────────
# Set to 0 to disable individual phases:
# KEE_SLEEP_SELF_EVOLUTION=1
# KEE_SLEEP_TOOL_EVOLUTION=1
# KEE_SLEEP_PLAN_LINKER=1

# ─────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────
KEE_LOG_LEVEL=INFO
